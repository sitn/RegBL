#! <SUBDOCUMENTS>
#! <SUBDOCUMENT
#!   NAME="AttributeConcatenator"
#!   ARCGIS_COMPATIBILITY=""
#!   CATEGORY="Attributes"
#!   DESCRIPTION="&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Concatenates selected attribute values in the order specified to the &quot;Concatenating Order&quot; parameter.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Resulting string consists of the original attribute values delimited by identical string specified to the &quot;Separator String&quot; parameter.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;This transformer considers both Null value and Missing attribute as an empty string. &lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;See also the AttributeListPopulator. &lt;/p&gt;&#10;"
#!   DOC_DYNAMIC_INPUT_ATTRS="0"
#!   DOC_EXTENTS="2816 18"
#!   DOC_TOP_LEFT="-353 -146"
#!   FME_DOCUMENT_GUID="88e19133-c1c0-4fc0-9c52-923ef30eab80"
#!   FME_DOCUMENT_PRIORGUID=""
#!   FME_NAMES_ENCODING="UTF-8"
#!   FME_PROCESS_COUNT="NO_PARALLELISM"
#!   FME_PROCESS_GROUPS_ORDERED="No"
#!   FME_PROCESS_GROUP_BY=""
#!   FME_PROCESS_PRESERVE_GROUP_ATTR="No"
#!   FMX_ATTRIBUTE_PROPOGATION_MODE="AUTO"
#!   GUID="88e19133-c1c0-4fc0-9c52-923ef30eab80"
#!   HISTORY="2014-10-18,Takashi&lt;space&gt;Iijima,Original&lt;space&gt;Implementation,2018-05-19,Takashi&lt;space&gt;Iijima,Corrected&lt;space&gt;the&lt;space&gt;Category"
#!   IS_VISIBLE="false"
#!   LAST_SAVE_BUILD="FME(R) 2014 SP5 (20141210 - Build 14440 - WIN32)"
#!   LAST_SAVE_DATE="2018-05-19T13:14:02"
#!   MARKDOWN_DESCRIPTION=""
#!   MARKDOWN_USAGE=""
#!   PYTHON_COMPATIBILITY=""
#!   REPLACED_BY=""
#!   SUPPRESS_UPGRADE="false"
#!   TITLE="AttributeConcatenator"
#!   USAGE="&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Parameters&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Attributes to Concatenate:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Select attributes which should be concatenated.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Concatenating Order:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Choose one of these as the concatenating order.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;- Value Numeric Ascending: sorted by attribute value numeric ascending&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;- Value Numeric Descending: sorted by attribute value numeric descending&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;- Value Alphabetic Ascending: sorted by attribute value alphabetic ascending&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;- Value Alphabetic Descending: sorted by attribute value alphabetic descending&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;- Name Ascending (Alphabetic): sorted by attribute name alphabetic ascending&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;- Name Descending (Alphabetic): sorted by attribute name alphabetic descending&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Note:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;In &quot;Value Numeric Ascending/Descending&quot;, the transformer considers every non-numeric value (including empty/null/missing) as 0.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;But a numeric representation surrounded by white spaces will be treated as a numeric value (both leading and trailing white spaces will be ignored).&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;And leading 0 of a numeric representation will also be ignored when comparing it as a numeric value to other values.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Case Sensitive:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Yes: The transformer will perform case-sensitive sorting.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;No (default): The transformer will perform case-insensitive sorting.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Note&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;The &quot;Case Sensitive&quot; parameter setting is basically applied to alphabetic sorting, but it will also be applied to non-numeric parts in numeric sorting, if non-numeric values exist.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Separator String:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Specify a string that will be used as the delimiter. You can set blank to this parameter not to use delimiter.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Trim Whitespaces:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;By default, the transformer will remove Both leading and trailing whitespaces from every original attribute value before concatenating, but you can change the setting to either Left or Right, or None.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Destination Attribute:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Specify name of the attribute that stores the resulting string.&lt;/p&gt;&#10;&lt;p style=&quot;-qt-paragraph-type:empty; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&#10;    &lt;br/&gt;&#10;&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Drop Empty Parts:&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Yes: The concatenation will be performed excluding empty parts.&lt;/p&gt;&#10;&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;No (default): The concatenation will be performed including empty parts. &lt;/p&gt;&#10;"
#!   USE_MARKDOWN=""
#!   VIEW_POSITION="-417 0"
#!   XFORM_DEPRECATED="No"
#!   ZOOM_SCALE="100"
#! >
#! <GLOBAL_PARAMETERS>
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI ATTRLIST_OR_ATTR ATTRS &quot; &quot; Attributes to Concatenate:"
#!   DEFAULT_VALUE=""
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI LOOKUP_CHOICE_OR_ATTR ORDER Value&lt;space&gt;Numeric&lt;space&gt;Ascending,ValueNumericAscending%Value&lt;space&gt;Numeric&lt;space&gt;Descending,ValueNumericDescending%Value&lt;space&gt;Alphabetic&lt;space&gt;Ascending,ValueAlphabeticAscending%Value&lt;space&gt;Alphabetic&lt;space&gt;Descending,ValueAlphabeticDescending%Name&lt;space&gt;Ascending&lt;space&gt;&lt;openparen&gt;Alphabetic&lt;closeparen&gt;,NameAscending%Name&lt;space&gt;Descending&lt;space&gt;&lt;openparen&gt;Alphabetic&lt;closeparen&gt;,NameDescending Concatenating Order:"
#!   DEFAULT_VALUE="ValueNumericAscending"
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI CHOICE_OR_ATTR CASE Yes%No Case Sensitive:"
#!   DEFAULT_VALUE="No"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI OPTIONAL TEXT_OR_ATTR SEP Separator String:"
#!   DEFAULT_VALUE=","
#!   IS_STAND_ALONE="true"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI CHOICE_OR_ATTR TRIM_OPTION Both%Left%Right%None Trim Whitespaces:"
#!   DEFAULT_VALUE="Both"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI NEW_ATTR_OR_ATTR DEST_ATTR TYPE:varchar(200) Destination Attribute:"
#!   DEFAULT_VALUE="_concatenated"
#!   IS_STAND_ALONE="false"
#! />
#! <GLOBAL_PARAMETER
#!   GUI_LINE="GUI CHOICE_OR_ATTR DROP_EMPTY_PARTS Yes%No Drop Empty Parts:"
#!   DEFAULT_VALUE="No"
#!   IS_STAND_ALONE="false"
#! />
#! </GLOBAL_PARAMETERS>
#! <USER_PARAMETERS
#!   FORM=""
#! >
#! <PARAMETER_INFO>
#!     <INFO NAME="ATTRS"
#!   DEFAULT_VALUE=""
#!   SCOPE="STAND_ALONE"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI ATTRLIST_OR_ATTR ATTRS &quot; &quot; Attributes to Concatenate:"
#! />
#!     <INFO NAME="ORDER"
#!   DEFAULT_VALUE="ValueNumericAscending"
#!   SCOPE="STAND_ALONE"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI LOOKUP_CHOICE_OR_ATTR ORDER Value&lt;space&gt;Numeric&lt;space&gt;Ascending,ValueNumericAscending%Value&lt;space&gt;Numeric&lt;space&gt;Descending,ValueNumericDescending%Value&lt;space&gt;Alphabetic&lt;space&gt;Ascending,ValueAlphabeticAscending%Value&lt;space&gt;Alphabetic&lt;space&gt;Descending,ValueAlphabeticDescending%Name&lt;space&gt;Ascending&lt;space&gt;&lt;openparen&gt;Alphabetic&lt;closeparen&gt;,NameAscending%Name&lt;space&gt;Descending&lt;space&gt;&lt;openparen&gt;Alphabetic&lt;closeparen&gt;,NameDescending Concatenating Order:"
#! />
#!     <INFO NAME="CASE"
#!   DEFAULT_VALUE="No"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI CHOICE_OR_ATTR CASE Yes%No Case Sensitive:"
#! />
#!     <INFO NAME="SEP"
#!   DEFAULT_VALUE=","
#!   SCOPE="STAND_ALONE"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI OPTIONAL TEXT_OR_ATTR SEP Separator String:"
#! />
#!     <INFO NAME="TRIM_OPTION"
#!   DEFAULT_VALUE="Both"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI CHOICE_OR_ATTR TRIM_OPTION Both%Left%Right%None Trim Whitespaces:"
#! />
#!     <INFO NAME="DEST_ATTR"
#!   DEFAULT_VALUE="_concatenated"
#!   SCOPE="DEPENDENT"
#!   GENERATED_GUI_LINE="false"
#!   GUI_LINE="GUI NEW_ATTR_OR_ATTR DEST_ATTR TYPE:varchar(200) Destination Attribute:"
#! />
