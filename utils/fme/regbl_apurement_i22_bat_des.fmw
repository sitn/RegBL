orted<space><openbracket>lsort<space><dollar>sorted<closebracket><semicolon><lf><space><space><space><space><space><space><space><space><closecurly><semicolon><lf><space><space><space><space><closecurly><space>elseif<space><opencurly><openbracket>regexp<space><opencurly>^Name.+<closecurly><space><dollar>order<closebracket><closecurly><space><opencurly><lf><space><space><space><space><space><space><space><space>if<space><opencurly><dollar>nocase<closecurly><space><opencurly><lf><space><space><space><space><space><space><space><space><space><space><space><space>set<space>attrs<space><openbracket>lsort<space>-nocase<space><dollar>attrs<closebracket><semicolon><lf><space><space><space><space><space><space><space><space><closecurly><space>else<space><opencurly><lf><space><space><space><space><space><space><space><space><space><space><space><space>set<space>attrs<space><openbracket>lsort<space><dollar>attrs<closebracket><semicolon><lf><space><space><space><space><space><space><space><space><closecurly><semicolon><lf><space><space><space><space><space><space><space><space>foreach<space>name<space><dollar>attrs<space><opencurly><lf><space><space><space><space><space><space><space><space><space><space><space><space>set<space>v<space><openbracket>getAttr<space><dollar>name<space><dollar>trimOption<closebracket><semicolon><lf><space><space><space><space><space><space><space><space><space><space><space><space>if<space><opencurly><dollar>keepEmpty<space>||<space>!<openbracket>string<space>equal<space><dollar>v<space><opencurly><closecurly><closebracket><closecurly><space><opencurly><lf><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space><space>lappend<space>sorted<space><dollar>v<semicolon><lf><space><space><space><space><space><space><space><space><space><space><space><space><closecurly><semicolon><lf><space><space><space><space><space><space><space><space><closecurly><semicolon><lf><space><space><space><space><closecurly><space>else<space><opencurly><lf><space><space><space><space><space><space><space><space>return<space><quote>Debug:<space>Invalid<space>Concatenation<space>Order:<space><dollar>order<quote><semicolon><lf><space><space><space><space><closecurly><semicolon><lf><space><space><space><space>set<space>delim<space><openbracket>FME_GetAttribute<space><quote>attributeconcatenator.sep<quote><closebracket><semicolon><lf><space><space><space><space>if<space><opencurly><openbracket>regexp<space><opencurly>.+Ascending<dollar><closecurly><space><dollar>order<closebracket><closecurly><space><opencurly><lf><space><space><space><space><space><space><space><space>return<space><openbracket>join<space><dollar>sorted<space><dollar>delim<closebracket><semicolon><lf><space><space><space><space><closecurly><space>elseif<space><opencurly><openbracket>regexp<space><opencurly>.+Descending<dollar><closecurly><space><dollar>order<closebracket><closecurly><space><opencurly><lf><space><space><space><space><space><space><space><space>return<space><openbracket>join<space><openbracket>lreverse<space><dollar>sorted<closebracket><space><dollar>delim<closebracket><semicolon><lf><space><space><space><space><closecurly><space>else<space><opencurly><lf><space><space><space><space><space><space><space><space>return<space><quote>Debug:<space>Invalid<space>Concatenation<space>Order:<space><dollar>order<quote><semicolon><lf><space><space><space><space><closecurly><semicolon><lf><closecurly>
MACRO COPIER @Tcl2("")
INCLUDE [ if {[string length {}] == 0} {             puts {MACRO COPIER 1} }
MACRO OUTPUTATTR "attributeconcatenator.dest_attr"
INCLUDE [ if {[string length {attributeconcatenator.dest_attr}] == 0} {             puts {MACRO OUTPUTATTR } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(AttributeConcatenator_WORKSPACE_NAME)_TclCaller }    INPUT  FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"    NUMBER_OF_COPIES { $(COPIER) }    OUTPUT { FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_TclCaller_OUTPUT"         $(OUTPUTATTR) @Tcl2("concatAttrs")          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME $(AttributeConcatenator_WORKSPACE_NAME)_BulkAttributeRenamer    INPUT  FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_TclCaller_OUTPUT"    OUTPUT { FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_BulkAttributeRenamer_OUTPUT"        @RenameAttributes(PATTERN_REPLACE, REGEXPREPLACE, <Unused>, ".+", "@EvaluateExpression(STRING_ENCODED,$($(AttributeConcatenator_WORKSPACE_NAME)_DEST_ATTR$encode),$(AttributeConcatenator_WORKSPACE_NAME)_BulkAttributeRenamer)", "<Unused>", "attributeconcatenator.dest_attr", "-_")         }
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory    FACTORY_NAME $(AttributeConcatenator_WORKSPACE_NAME)_BulkAttributeRemover    INPUT  FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_BulkAttributeRenamer_OUTPUT"    OUTPUT FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_BulkAttributeRemover_OUTPUT"        @RemoveAttributes(fme_regexp_match,^attributeconcatenator.+)
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(AttributeConcatenator_WORKSPACE_NAME)_Output1777882448 Output Collector"   INPUT FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_BulkAttributeRemover_OUTPUT"   OUTPUT FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_Output"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(AttributeConcatenator_WORKSPACE_NAME))}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "AttributeConcatenator Output Output Renamer/Nuker"   INPUT FEATURE_TYPE AttributeConcatenator_Output   OUTPUT FEATURE_TYPE AttributeConcatenator_Output
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "AttributeConcatenator_2 Input Input Collector"   INPUT FEATURE_TYPE AttributeConcatenator_Output   OUTPUT FEATURE_TYPE AttributeConcatenator_2_Input
MACRO AttributeConcatenator_WORKSPACE_NAME AttributeConcatenator_2
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_TRANSFORMER_GROUP
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_XFORMER_NAME AttributeConcatenator_2
MACRO $(AttributeConcatenator_WORKSPACE_NAME)___COMPOUND_PARAMETERS
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_ATTRS mo22_batiments_desnat _desba
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_ORDER NameDescending
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_CASE No
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_SEP ,
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_TRIM_OPTION Both
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_DEST_ATTR desba_tmp
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_DROP_EMPTY_PARTS Yes
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_SUB_DOC_NAME AttributeConcatenator
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_SUB_DOC_NAME AttributeConcatenator
DEFAULT_MACRO AttributeConcatenator_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(AttributeConcatenator_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(AttributeConcatenator_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(AttributeConcatenator_WORKSPACE_NAME)_Input1777882448 Input Splitter"   INPUT FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_Input"   OUTPUT FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_Input"
# -------------------------------------------------------------------------
Tcl2 proc $(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"attributeconcatenator.attrs {$($(AttributeConcatenator_WORKSPACE_NAME)_ATTRS$encode)} attributeconcatenator.sep {$($(AttributeConcatenator_WORKSPACE_NAME)_SEP$encode)} attributeconcatenator.order {$($(AttributeConcatenator_WORKSPACE_NAME)_ORDER)} attributeconcatenator.case {$($(AttributeConcatenator_WORKSPACE_NAME)_CASE$encode)} attributeconcatenator.trim_option {$($(AttributeConcatenator_WORKSPACE_NAME)_TRIM_OPTION$encode)} attributeconcatenator.drop_empty {$($(AttributeConcatenator_WORKSPACE_NAME)_DROP_EMPTY_PARTS$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_Input"    OUTPUT { FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
