FACTORY_DEF * TeeFactory   FACTORY_NAME "AttributeConcatenator Input Input Collector"   INPUT FEATURE_TYPE SpatialFilter_PASSED   OUTPUT FEATURE_TYPE AttributeConcatenator_Input
MACRO AttributeConcatenator_WORKSPACE_NAME AttributeConcatenator
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_TRANSFORMER_GROUP
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_XFORMER_NAME AttributeConcatenator
MACRO $(AttributeConcatenator_WORKSPACE_NAME)___COMPOUND_PARAMETERS
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_ATTRS mo22_batiments_desba1 mo22_batiments_desba2 mo22_batiments_desba3
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_ORDER ValueNumericAscending
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_CASE No
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_SEP ,
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_TRIM_OPTION Both
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_DEST_ATTR _desba
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_DROP_EMPTY_PARTS Yes
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_SUB_DOC_NAME AttributeConcatenator
MACRO $(AttributeConcatenator_WORKSPACE_NAME)_SUB_DOC_NAME AttributeConcatenator
DEFAULT_MACRO AttributeConcatenator_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(AttributeConcatenator_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(AttributeConcatenator_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(AttributeConcatenator_WORKSPACE_NAME)_Input1777882448 Input Splitter"   INPUT FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_Input"   OUTPUT FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_Input"
# -------------------------------------------------------------------------
Tcl2 proc $(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher_doFetch {} {    foreach {name val} {"attributeconcatenator.attrs {$($(AttributeConcatenator_WORKSPACE_NAME)_ATTRS$encode)} attributeconcatenator.sep {$($(AttributeConcatenator_WORKSPACE_NAME)_SEP$encode)} attributeconcatenator.order {$($(AttributeConcatenator_WORKSPACE_NAME)_ORDER)} attributeconcatenator.case {$($(AttributeConcatenator_WORKSPACE_NAME)_CASE$encode)} attributeconcatenator.trim_option {$($(AttributeConcatenator_WORKSPACE_NAME)_TRIM_OPTION$encode)} attributeconcatenator.drop_empty {$($(AttributeConcatenator_WORKSPACE_NAME)_DROP_EMPTY_PARTS$encode)}"} {         if { [string match {*<at>*} $val] == 1 } {             set val [FME_Execute EvaluateExpression {STRING} $val {$(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher}];         } elseif {[string match {*FME_CONDITIONAL*} $val] == 1} {             set val [FME_Execute EvaluateExpression {STRING} $val {$(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher}];         } else {             set val [FME_DecodeTextOrAttr $val];         };       FME_SetAttribute [FME_DecodeText $name] $val    } }
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher }    INPUT  FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_Input"    OUTPUT { FEATURE_TYPE "$(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher_OUTPUT"         @Tcl2($(AttributeConcatenator_WORKSPACE_NAME)_ParameterFetcher_doFetch)          }
